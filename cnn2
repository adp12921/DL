
# Pract 3: CNN - Original vs CNN with Variations

import tensorflow as tf
from tensorflow import keras
import matplotlib.pyplot as plt
import time

# Load Fashion MNIST
(X_train, y_train), (X_test, y_test) = keras.datasets.fashion_mnist.load_data()

# Normalize
X_train = X_train / 255.0
X_test = X_test / 255.0

# Reshape for CNN
X_train = X_train.reshape(-1, 28, 28, 1)
X_test = X_test.reshape(-1, 28, 28, 1)

# One-hot encoding
y_train = keras.utils.to_categorical(y_train, 10)
y_test = keras.utils.to_categorical(y_test, 10)

# ---------------- MODEL 1: ORIGINAL CNN ----------------

model1 = keras.Sequential([
    keras.layers.Input(shape=(28, 28, 1)),
    keras.layers.Conv2D(32, (3, 3), activation='relu'),
    keras.layers.MaxPooling2D((2, 2)),
    keras.layers.Conv2D(64, (3, 3), activation='relu'),
    keras.layers.MaxPooling2D((2, 2)),
    keras.layers.Flatten(),
    keras.layers.Dense(128, activation='relu'),
    keras.layers.Dense(10, activation='softmax')
])

model1.compile(optimizer='adam', loss='mse', metrics=['accuracy'])

start = time.time()
history1 = model1.fit(
    X_train, y_train, epochs=5,
    validation_split=0.1, verbose=1
)
time1 = time.time() - start

loss1, acc1 = model1.evaluate(X_test, y_test, verbose=0)

# ---------------- MODEL 2: CNN WITH VARIATIONS ----------------

model2 = keras.Sequential([
    keras.layers.Input(shape=(28, 28, 1)),
    keras.layers.Conv2D(32, (3, 3), padding='same', use_bias=False),
    keras.layers.BatchNormalization(),
    keras.layers.Activation('relu'),
    keras.layers.MaxPooling2D((2, 2)),
    keras.layers.Dropout(0.25),

    keras.layers.Conv2D(64, (3, 3), padding='same', use_bias=False),
    keras.layers.BatchNormalization(),
    keras.layers.Activation('relu'),
    keras.layers.MaxPooling2D((2, 2)),
    keras.layers.Dropout(0.25),

    keras.layers.Flatten(),
    keras.layers.Dense(128, use_bias=False),
    keras.layers.BatchNormalization(),
    keras.layers.Activation('relu'),
    keras.layers.Dropout(0.5),
    keras.layers.Dense(10, activation='softmax')
])

model2.compile(optimizer='adam', loss='mse', metrics=['accuracy'])

early_stop = keras.callbacks.EarlyStopping(
    monitor='val_loss', patience=2, restore_best_weights=True
)

start = time.time()
history2 = model2.fit(
    X_train, y_train, epochs=5,
    validation_split=0.1,
    callbacks=[early_stop], verbose=1
)
time2 = time.time() - start

loss2, acc2 = model2.evaluate(X_test, y_test, verbose=0)

# ---------------- COMPARISON ----------------

print("\nMODEL COMPARISON")
print("-" * 55)
print(f"{'Metric':<20}{'Original CNN':<17}{'CNN Variations':<17}")
print("-" * 55)
print(f"{'Test Accuracy':<20}{acc1*100:.2f}%{'':<12}{acc2*100:.2f}%")
print(f"{'Test Loss':<20}{loss1:.4f}{'':<12}{loss2:.4f}")
print(f"{'Training Time':<20}{time1:.2f} sec{'':<8}{time2:.2f} sec")
print(f"{'Epochs Completed':<20}{len(history1.history['loss']):<17}"
      f"{len(history2.history['loss']):<17}")

# ---------------- GRAPH 1: ACCURACY ----------------

plt.figure(figsize=(12, 5))

plt.subplot(1, 2, 1)
plt.plot(history1.history['accuracy'], marker='o', label='Original Train')
plt.plot(history1.history['val_accuracy'], marker='o', label='Original Val')
plt.plot(history2.history['accuracy'], marker='s', label='Variation Train')
plt.plot(history2.history['val_accuracy'], marker='s', label='Variation Val')
plt.title('CNN Accuracy Comparison')
plt.xlabel('Epoch')
plt.ylabel('Accuracy')
plt.legend()
plt.grid(True)

# ---------------- GRAPH 2: LOSS ----------------

plt.subplot(1, 2, 2)
plt.plot(history1.history['loss'], marker='o', label='Original Train')
plt.plot(history1.history['val_loss'], marker='o', label='Original Val')
plt.plot(history2.history['loss'], marker='s', label='Variation Train')
plt.plot(history2.history['val_loss'], marker='s', label='Variation Val')
plt.title('CNN Loss Comparison')
plt.xlabel('Epoch')
plt.ylabel('MSE Loss')
plt.legend()
plt.grid(True)

plt.tight_layout()
plt.show()

# ---------------- GRAPH 3: TEST ACCURACY ----------------

plt.figure(figsize=(6, 4))
plt.bar(['Original CNN', 'CNN Variations'],
        [acc1 * 100, acc2 * 100])
plt.title('Test Accuracy Comparison')
plt.ylabel('Accuracy (%)')
plt.ylim(0, 100)
plt.show()

# Model summaries
print("\nORIGINAL CNN SUMMARY")
model1.summary()

print("\nCNN WITH VARIATIONS SUMMARY")
model2.summary()

# rnn with lstm  (chatgpt)   (Pract 6)


import numpy as np
from tensorflow.keras.utils import get_file
from tensorflow.keras.models import Sequential
from tensorflow.keras.layers import LSTM, Dense
from tensorflow.keras.optimizers import RMSprop

# 1. Load text
path = get_file(
    "nietzsche.txt",
    origin="https://s3.amazonaws.com/text-datasets/nietzsche.txt"
)
text = open(path, encoding="utf-8").read().lower()
print("Text length:", len(text))

# 2. Character vocabulary
chars = sorted(set(text))
char_to_index = {c: i for i, c in enumerate(chars)}
index_to_char = {i: c for i, c in enumerate(chars)}
num_chars = len(chars)

# 3. Create sequences
seq_length = 40
step = 3
sentences, next_chars = [], []

for i in range(0, len(text) - seq_length, step):
    sentences.append(text[i:i + seq_length])
    next_chars.append(text[i + seq_length])

# 4. One-hot encoding
X = np.zeros((len(sentences), seq_length, num_chars))
y = np.zeros((len(sentences), num_chars))

for i, sentence in enumerate(sentences):
    for t, char in enumerate(sentence):
        X[i, t, char_to_index[char]] = 1
    y[i, char_to_index[next_chars[i]]] = 1

# 5. Build LSTM model
model = Sequential([
    LSTM(128, input_shape=(seq_length, num_chars)),
    Dense(num_chars, activation="softmax")
])

model.compile(
    loss="categorical_crossentropy",
    optimizer=RMSprop(learning_rate=0.01)
)
model.summary()

# 6. Train model
model.fit(X, y, batch_size=128, epochs=10)

# 7. Generate text
seed_text = text[:seq_length]
generated_text = seed_text

for _ in range(200):
    input_data = np.zeros((1, seq_length, num_chars))

    for t, char in enumerate(seed_text):
        input_data[0, t, char_to_index[char]] = 1

    prediction = model.predict(input_data, verbose=0)[0]
    next_index = np.argmax(prediction)
    next_char = index_to_char[next_index]

    generated_text += next_char
    seed_text = seed_text[1:] + next_char

print("\nGenerated Text:\n", generated_text)
